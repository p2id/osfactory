{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-software-factory.org/schema/project/1.1.0",
  "title": "Open Software Factory Project",
  "description": "Canonical schema for one build-ready software project specification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "record_type", "identity", "problem", "users", "solution", "use_cases", "scope", "features", "requirements", "constraints", "validation", "architecture", "technology", "data", "interfaces", "security", "testing", "deployment", "roadmap", "tasks", "relationships", "risks", "open_questions", "provenance", "maturity", "quality", "extensions"],
  "properties": {
    "schema_version": {"$ref": "#/$defs/semver"},
    "id": {"type": "string", "pattern": "^OSF-[0-9]{8}$"},
    "record_type": {"const": "project"},
    "identity": {"$ref": "#/$defs/identity"},
    "problem": {"$ref": "#/$defs/problem"},
    "users": {"$ref": "#/$defs/users"},
    "solution": {"$ref": "#/$defs/solution"},
    "use_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/use_case"}},
    "scope": {"$ref": "#/$defs/scope"},
    "features": {"$ref": "#/$defs/features"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "constraints": {"$ref": "#/$defs/constraints"},
    "validation": {"$ref": "#/$defs/validation"},
    "architecture": {"$ref": "#/$defs/architecture"},
    "technology": {"$ref": "#/$defs/technology"},
    "data": {"$ref": "#/$defs/data"},
    "interfaces": {"$ref": "#/$defs/interfaces"},
    "ux": {"$ref": "#/$defs/ux"},
    "security": {"$ref": "#/$defs/security"},
    "testing": {"$ref": "#/$defs/testing"},
    "deployment": {"$ref": "#/$defs/deployment"},
    "roadmap": {"$ref": "#/$defs/roadmap"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "relationships": {"$ref": "#/$defs/relationships"},
    "risks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/risk"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "maturity": {"$ref": "#/$defs/maturity"},
    "quality": {"$ref": "#/$defs/quality"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "allOf": [
    {"if": {"properties": {"identity": {"properties": {"type": {"enum": ["web_application", "mobile_application", "desktop_application", "browser_extension", "game"]}}}}}, "then": {"required": ["ux"]}},
    {"if": {"properties": {"identity": {"properties": {"type": {"const": "cli"}}}}}, "then": {"properties": {"interfaces": {"required": ["commands"]}}}},
    {"if": {"properties": {"identity": {"properties": {"type": {"enum": ["api", "protocol", "sdk", "library", "framework"]}}}}}, "then": {"properties": {"interfaces": {"required": ["public_contracts"]}}}}
  ],
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nonempty": {"type": "string", "minLength": 1},
    "id_ref": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "status": {"type": "string", "enum": ["draft", "researching", "validation", "needs_repair", "ready_to_build", "quarantined", "rejected", "superseded"]},
    "level": {"type": "string", "enum": ["C0", "C1", "C2", "C3", "C4", "C5", "C6", "C7"]},
    "novelty": {"type": "string", "enum": ["N0", "N1", "N2", "N3", "N4", "N5"]},
    "named_item": {"type": "object", "additionalProperties": false, "required": ["id", "name", "description"], "properties": {"id": {"$ref": "#/$defs/id_ref"}, "name": {"$ref": "#/$defs/nonempty"}, "description": {"$ref": "#/$defs/nonempty"}, "references": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["title", "slug", "category", "type", "domains", "tags"], "properties": {"title": {"$ref": "#/$defs/nonempty"}, "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "category": {"$ref": "#/$defs/id_ref"}, "domains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id_ref"}}, "type": {"type": "string", "enum": ["web_application", "mobile_application", "desktop_application", "cli", "library", "sdk", "api", "framework", "database", "runtime", "compiler", "programming_language", "protocol", "browser_extension", "plugin", "game", "game_engine", "ai_agent", "automation_system", "infrastructure_tool", "developer_platform", "data_platform", "dataset_tool", "research_software", "simulation", "embedded_software", "hardware_connected_software", "os_level_software", "p2p_software", "federated_software", "serverless_software", "edge_software", "local_first_software", "offline_first_software", "git_native_software", "experimental_software"]}, "tags": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "complexity": {"$ref": "#/$defs/level"}, "novelty": {"$ref": "#/$defs/novelty"}}},
    "problem": {"type": "object", "additionalProperties": false, "required": ["statement", "context", "affected_users", "current_workarounds"], "properties": {"statement": {"$ref": "#/$defs/nonempty"}, "context": {"$ref": "#/$defs/nonempty"}, "affected_users": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id_ref"}}, "current_workarounds": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "users": {"type": "object", "additionalProperties": false, "required": ["primary", "secondary"], "properties": {"primary": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}, "secondary": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "solution": {"type": "object", "additionalProperties": false, "required": ["summary", "description", "core_value"], "properties": {"summary": {"$ref": "#/$defs/nonempty"}, "description": {"$ref": "#/$defs/nonempty"}, "core_value": {"$ref": "#/$defs/nonempty"}}},
    "use_case": {"type": "object", "additionalProperties": false, "required": ["id", "actor", "scenario", "expected_result"], "properties": {"id": {"type": "string", "pattern": "^UC-[0-9]{3,}$"}, "actor": {"$ref": "#/$defs/nonempty"}, "scenario": {"$ref": "#/$defs/nonempty"}, "expected_result": {"$ref": "#/$defs/nonempty"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["mvp", "out_of_scope"], "properties": {"mvp": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}, "out_of_scope": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}}},
    "features": {"type": "object", "additionalProperties": false, "required": ["mvp", "post_mvp"], "properties": {"mvp": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named_item"}}, "post_mvp": {"type": "array", "items": {"$ref": "#/$defs/named_item"}}}},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["functional", "non_functional"], "properties": {"functional": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}, "non_functional": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "priority", "acceptance_criteria"], "properties": {"id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}, "statement": {"$ref": "#/$defs/nonempty"}, "priority": {"type": "string", "enum": ["must", "should", "could"]}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}, "source_use_cases": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}}},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["technical", "operational", "legal", "economic"], "properties": {"technical": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "operational": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "legal": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "economic": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["problem", "technical", "evidence", "assumptions", "hypotheses", "unknowns", "experiments"], "properties": {"problem": {"$ref": "#/$defs/validation_status"}, "technical": {"$ref": "#/$defs/validation_status"}, "demand": {"$ref": "#/$defs/market_feedback_status"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "assumptions": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}}, "feedback_loop": {"type": "array", "items": {"$ref": "#/$defs/feedback_event"}}}},
    "validation_status": {"type": "string", "enum": ["verified", "supported", "partially_supported", "unknown", "experimental", "not_applicable"]},
    "market_feedback_status": {"type": "string", "enum": ["not_started", "market_tested", "market_validated", "growing", "unknown"]},
    "feedback_event": {"type": "object", "additionalProperties": false, "required": ["stage", "status", "observed_at"], "properties": {"stage": {"type": "string", "enum": ["built", "deployed", "market_tested", "market_validated", "growing"]}, "status": {"type": "string", "enum": ["observed", "supported", "unknown"]}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "notes": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "type", "claim", "reference_ids"], "properties": {"id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}, "type": {"type": "string", "enum": ["problem", "demand", "technical_feasibility", "user", "market", "experiment", "observation"]}, "claim": {"$ref": "#/$defs/nonempty"}, "reference_ids": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "limitations": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "experiment": {"type": "object", "additionalProperties": false, "required": ["id", "hypothesis", "method", "success_criteria"], "properties": {"id": {"type": "string", "pattern": "^EXP-[0-9]{3,}$"}, "hypothesis": {"$ref": "#/$defs/nonempty"}, "method": {"$ref": "#/$defs/nonempty"}, "success_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}, "result": {"type": "string"}}},
    "architecture": {"type": "object", "additionalProperties": false, "required": ["style_refs", "components", "data_flow", "scaling_strategy", "rationale"], "properties": {"style_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id_ref"}}, "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named_item"}}, "data_flow": {"$ref": "#/$defs/nonempty"}, "scaling_strategy": {"$ref": "#/$defs/nonempty"}, "rationale": {"$ref": "#/$defs/nonempty"}, "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}}}},
    "technology": {"type": "object", "additionalProperties": false, "required": ["language_refs", "technology_refs", "selection_rationale"], "properties": {"language_refs": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "technology_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id_ref"}}, "selection_rationale": {"$ref": "#/$defs/nonempty"}, "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}}}},
    "alternative": {"type": "object", "additionalProperties": false, "required": ["name", "strengths", "weaknesses"], "properties": {"name": {"$ref": "#/$defs/nonempty"}, "strengths": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "weaknesses": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "reason_rejected": {"type": "string"}}},
    "data": {"type": "object", "additionalProperties": false, "required": ["entities", "relationships"], "properties": {"entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "relationships": {"type": "array", "items": {"$ref": "#/$defs/data_relationship"}}, "storage_rationale": {"type": "string"}}},
    "entity": {"type": "object", "additionalProperties": false, "required": ["id", "name", "purpose", "attributes"], "properties": {"id": {"type": "string", "pattern": "^ENT-[0-9]{3,}$"}, "name": {"$ref": "#/$defs/nonempty"}, "purpose": {"$ref": "#/$defs/nonempty"}, "attributes": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "sensitivity": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]}}},
    "data_relationship": {"type": "object", "additionalProperties": false, "required": ["from", "to", "kind"], "properties": {"from": {"$ref": "#/$defs/id_ref"}, "to": {"$ref": "#/$defs/id_ref"}, "kind": {"$ref": "#/$defs/nonempty"}}},
    "interfaces": {"type": "object", "additionalProperties": false, "required": ["kinds"], "properties": {"kinds": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["http_api", "graphql", "grpc", "cli", "library_api", "sdk_api", "protocol", "event", "message", "file", "hardware", "ui", "other"]}}, "endpoints": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}}, "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}}, "public_contracts": {"type": "array", "items": {"$ref": "#/$defs/public_contract"}}, "authentication": {"type": "string"}, "versioning": {"type": "string"}, "errors": {"type": "string"}}},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["id", "method", "path", "purpose"], "properties": {"id": {"type": "string", "pattern": "^INT-[0-9]{3,}$"}, "method": {"$ref": "#/$defs/nonempty"}, "path": {"$ref": "#/$defs/nonempty"}, "purpose": {"$ref": "#/$defs/nonempty"}, "auth": {"type": "string"}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["id", "name", "purpose"], "properties": {"id": {"type": "string", "pattern": "^CMD-[0-9]{3,}$"}, "name": {"$ref": "#/$defs/nonempty"}, "purpose": {"$ref": "#/$defs/nonempty"}, "inputs": {"type": "array", "items": {"type": "string"}}, "outputs": {"type": "array", "items": {"type": "string"}}}},
    "public_contract": {"type": "object", "additionalProperties": false, "required": ["id", "name", "purpose"], "properties": {"id": {"type": "string", "pattern": "^API-[0-9]{3,}$"}, "name": {"$ref": "#/$defs/nonempty"}, "purpose": {"$ref": "#/$defs/nonempty"}, "inputs": {"type": "array", "items": {"type": "string"}}, "outputs": {"type": "array", "items": {"type": "string"}}}},
    "ux": {"type": "object", "additionalProperties": false, "required": ["flows", "screens", "states", "accessibility"], "properties": {"flows": {"type": "array", "items": {"$ref": "#/$defs/named_item"}}, "screens": {"type": "array", "items": {"$ref": "#/$defs/named_item"}}, "states": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "accessibility": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "security": {"type": "object", "additionalProperties": false, "required": ["authentication", "authorization", "threats", "mitigations", "privacy", "secrets_management"], "properties": {"authentication": {"$ref": "#/$defs/nonempty"}, "authorization": {"$ref": "#/$defs/nonempty"}, "threats": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named_item"}}, "mitigations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named_item"}}, "privacy": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "secrets_management": {"$ref": "#/$defs/nonempty"}, "trust_boundaries": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "testing": {"type": "object", "additionalProperties": false, "required": ["unit", "integration", "e2e", "performance", "security", "regression"], "properties": {"unit": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "integration": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "e2e": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "performance": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "security": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "regression": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "deployment": {"type": "object", "additionalProperties": false, "required": ["development", "production", "packaging", "configuration", "migrations", "monitoring", "backup", "recovery"], "properties": {"development": {"$ref": "#/$defs/nonempty"}, "production": {"$ref": "#/$defs/nonempty"}, "packaging": {"$ref": "#/$defs/nonempty"}, "configuration": {"$ref": "#/$defs/nonempty"}, "migrations": {"$ref": "#/$defs/nonempty"}, "monitoring": {"$ref": "#/$defs/nonempty"}, "backup": {"$ref": "#/$defs/nonempty"}, "recovery": {"$ref": "#/$defs/nonempty"}}},
    "roadmap": {"type": "object", "additionalProperties": false, "required": ["phase_1", "phase_2", "phase_3"], "properties": {"phase_1": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}, "phase_2": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}, "phase_3": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "title", "description", "dependencies", "acceptance_criteria"], "properties": {"id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"}, "title": {"$ref": "#/$defs/nonempty"}, "description": {"$ref": "#/$defs/nonempty"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}, "requirement_ids": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}}},
    "relationships": {"type": "object", "additionalProperties": false, "required": ["inspired_by", "alternative_to", "extension_of", "derived_from", "related_to", "depends_on", "uses_architecture", "uses_technology", "belongs_to_family"], "properties": {"inspired_by": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "alternative_to": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "extension_of": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "derived_from": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "related_to": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "uses_architecture": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "uses_technology": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}, "belongs_to_family": {"type": "array", "items": {"$ref": "#/$defs/id_ref"}}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["id", "description", "likelihood", "impact", "mitigation", "status"], "properties": {"id": {"type": "string", "pattern": "^RISK-[0-9]{3,}$"}, "description": {"$ref": "#/$defs/nonempty"}, "likelihood": {"type": "string", "enum": ["low", "medium", "high", "unknown"]}, "impact": {"type": "string", "enum": ["low", "medium", "high", "unknown"]}, "mitigation": {"$ref": "#/$defs/nonempty"}, "status": {"type": "string", "enum": ["open", "accepted", "mitigated", "transferred", "unknown"]}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "question", "blocking"], "properties": {"id": {"type": "string", "pattern": "^Q-[0-9]{3,}$"}, "question": {"$ref": "#/$defs/nonempty"}, "blocking": {"type": "boolean"}, "owner": {"type": "string"}, "resolution": {"type": "string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created_at", "updated_at", "generator", "references", "change_history"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "generator": {"$ref": "#/$defs/nonempty"}, "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}, "change_history": {"type": "array", "items": {"$ref": "#/$defs/change"}}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["id", "title", "source_type", "source_url", "accessed"], "properties": {"id": {"type": "string", "pattern": "^REF-[0-9]{3,}$"}, "title": {"$ref": "#/$defs/nonempty"}, "source_type": {"$ref": "#/$defs/nonempty"}, "source_url": {"type": "string", "format": "uri"}, "publisher": {"type": "string"}, "date": {"type": "string"}, "accessed": {"type": "string", "format": "date"}, "notes": {"type": "string"}}},
    "change": {"type": "object", "additionalProperties": false, "required": ["version", "changed_at", "reason"], "properties": {"version": {"$ref": "#/$defs/semver"}, "changed_at": {"type": "string", "format": "date-time"}, "reason": {"$ref": "#/$defs/nonempty"}}},
    "maturity": {"type": "object", "additionalProperties": false, "required": ["status", "readiness_basis"], "properties": {"status": {"type": "string", "enum": ["theoretical", "buildable", "mvp_ready", "built", "deployed", "market_tested", "market_validated", "growing"]}, "readiness_basis": {"$ref": "#/$defs/nonempty"}}},
    "quality": {"type": "object", "additionalProperties": false, "required": ["completeness", "gate_results", "build_readiness"], "properties": {"completeness": {"type": "number", "minimum": 0, "maximum": 1}, "gate_results": {"type": "object", "additionalProperties": {"type": "string", "enum": ["pass", "fail", "not_applicable", "unknown"]}}, "build_readiness": {"type": "string", "enum": ["pass", "fail", "unknown"]}, "research_level": {"type": "string"}, "validation_level": {"type": "string"}, "uniqueness_level": {"type": "string"}, "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean"]}}}},
    "extensions": {"type": "object", "additionalProperties": {"type": "object", "required": ["version", "payload"], "properties": {"version": {"$ref": "#/$defs/semver"}, "schema_uri": {"type": "string", "format": "uri-reference"}, "payload": {"type": "object"}}, "additionalProperties": false}}
  }
}
